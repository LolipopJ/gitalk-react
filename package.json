{
  "name": "gitalk-react",
  "version": "1.0.0",
  "private": false,
  "author": {
    "name": "LolipopJ",
    "email": "mail@towind.cn",
    "url": "https://github.com/LolipopJ"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LolipopJ/gitalk-react.git"
  },
  "homepage": "https://lolipopj.github.io/gitalk-react",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/",
    "lib/",
    "proxy-server/",
    "LICENSE",
    "package.json",
    "README-zh-CN.md",
    "README.md"
  ],
  "main": "./dist/gitalk.umd.cjs",
  "module": "./dist/gitalk.js",
  "exports": {
    ".": {
      "import": "./dist/gitalk.js",
      "require": "./dist/gitalk.umd.cjs"
    },
    "./gitalk.css": "./dist/gitalk-light.css",
    "./light.css": "./dist/gitalk-light.css",
    "./gitalk-light.css": "./dist/gitalk-light.css",
    "./dark.css": "./dist/gitalk-dark.css",
    "./gitalk-dark.css": "./dist/gitalk-dark.css"
  },
  "types": "./dist/gitalk.d.ts",
  "scripts": {
    "dev": "vite --config vite.config.preview.ts",
    "build": "yarn build:lib && yarn build:preview",
    "build:lib": "yarn build:ts && yarn build:scss",
    "build:ts": "tsc -b && vite build",
    "build:scss": "vite build --config vite.config.scss.ts",
    "build:preview": "vite build --config vite.config.preview.ts",
    "lint": "yarn lint:ts && yarn lint:scss",
    "lint:ts": "eslint . --fix",
    "lint:scss": "stylelint **/*.scss --fix",
    "start:proxy": "node --env-file=proxy-server/.env.local proxy-server/server.mjs",
    "test": "node --test test/*.test.mjs proxy-server/server.test.mjs",
    "test:animation": "node --test test/animated-comments.test.mjs",
    "test:i18n": "node --test test/i18n.test.mjs",
    "test:oauth": "node --test test/oauth.test.mjs proxy-server/server.test.mjs",
    "test:discussion": "node --test test/discussion.test.mjs",
    "test:preview": "node --test test/preview.test.mjs"
  },
  "dependencies": {
    "ahooks": "^3.10.0",
    "classnames": "^2.5.1",
    "node-polyglot": "^2.6.0",
    "octokit": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@octokit/types": "^18.0.0",
    "@types/node": "^24.19.2",
    "@types/node-polyglot": "^2.5.0",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "github-markdown-css": "^5.9.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
