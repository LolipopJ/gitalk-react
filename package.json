{
  "name": "gitalk-react",
  "version": "1.0.0",
  "private": false,
  "author": {
    "name": "LolipopJ",
    "email": "mail@towind.cn",
    "url": "https://github.com/LolipopJ"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LolipopJ/gitalk-react.git"
  },
  "homepage": "https://lolipopj.github.io/gitalk-react",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "files": [
    "dist/",
    "proxy-server/",
    "LICENSE",
    "package.json",
    "README-zh-CN.md",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/gitalk.cjs",
  "module": "./dist/gitalk.js",
  "unpkg": "./dist/gitalk.browser.full.js",
  "jsdelivr": "./dist/gitalk.browser.full.js",
  "exports": {
    ".": {
      "unpkg": "./dist/gitalk.browser.full.js",
      "import": {
        "types": "./dist/gitalk.d.mts",
        "default": "./dist/gitalk.js"
      },
      "require": {
        "types": "./dist/gitalk.d.cts",
        "default": "./dist/gitalk.cjs"
      }
    },
    "./gitalk.css": "./dist/gitalk-light.css",
    "./light.css": "./dist/gitalk-light.css",
    "./gitalk-light.css": "./dist/gitalk-light.css",
    "./dark.css": "./dist/gitalk-dark.css",
    "./gitalk-dark.css": "./dist/gitalk-dark.css"
  },
  "types": "./dist/gitalk.d.mts",
  "scripts": {
    "dev": "vite --config vite.config.preview.ts",
    "build": "tsc -b && pnpm run build:lib && pnpm run build:browser && pnpm run build:scss && pnpm run build:preview",
    "build:lib": "vite build",
    "build:browser": "vite build --config vite.config.browser.ts && vite build --config vite.config.browser.ts --mode full",
    "build:scss": "vite build --config vite.config.scss.ts",
    "build:preview": "vite build --config vite.config.preview.ts",
    "analyze": "vite build --mode analyze",
    "prepack": "pnpm run test",
    "lint": "pnpm run lint:ts && pnpm run lint:scss",
    "lint:ts": "eslint . --fix",
    "lint:scss": "stylelint {dev,lib}/**/*.scss --fix",
    "start:proxy": "node --env-file=proxy-server/.env.local proxy-server/server.mjs",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@octokit/types": "^18.0.0",
    "ahooks": "^3.10.0",
    "classnames": "^2.5.1",
    "node-polyglot": "^2.6.0",
    "octokit": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.19.2",
    "@types/node-polyglot": "^2.5.0",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "@types/react-latest": "npm:@types/react@latest",
    "@types/react-dom-latest": "npm:@types/react-dom@latest",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "github-markdown-css": "^5.9.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-latest": "npm:react@latest",
    "react-dom-latest": "npm:react-dom@latest",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
